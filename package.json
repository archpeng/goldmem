{
  "name": "goldmem",
  "version": "0.1.0",
  "private": true,
  "description": "Elder-first AI memory and reminder system.",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "architecture:check": "tsx scripts/architecture-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:api:env": "bash -lc 'set -a; source .env; set +a; pnpm --filter @goldmem/api-server dev'",
    "dev:web": "pnpm --filter @goldmem/web-mvp dev",
    "mvp:verify": "pnpm typecheck && pnpm test && pnpm build && pnpm lint && pnpm eval && pnpm architecture:check",
    "mvp:smoke": "tsx scripts/mvp-smoke.ts",
    "e2e:golden": "tsx scripts/golden-e2e.ts",
    "mem0:smoke": "tsx scripts/mem0-smoke.ts",
    "semantic:rebuild": "tsx scripts/rebuild-semantic-memory.ts",
    "eval": "tsx scripts/eval-runner.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "zod": "^3.24.4"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "openai": "^6.37.0",
    "pg": "^8.20.0"
  }
}
